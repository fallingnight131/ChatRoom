#include <windows.h>

IDI_CHATROOM_APP ICON DISCARDABLE "@CHATROOM_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @CHATROOM_PRODUCT_VERSION_COMMAS@,0
 PRODUCTVERSION @CHATROOM_PRODUCT_VERSION_COMMAS@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "QtChatRoom\0"
            VALUE "FileDescription", "@CHATROOM_RC_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@CHATROOM_PRODUCT_VERSION@.0\0"
            VALUE "InternalName", "@CHATROOM_RC_ORIGINAL_FILENAME@\0"
            VALUE "OriginalFilename", "@CHATROOM_RC_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "Chat Room\0"
            VALUE "ProductVersion", "@CHATROOM_PRODUCT_VERSION@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
